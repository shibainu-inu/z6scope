+def snooze(seconds: float) -> None:
+    """Sleep that reacts to SIGTERM/Ctrl+C within ~1 s."""
+    end = time.monotonic() + seconds
+    while not _stop:
+        left = end - time.monotonic()
+        if left <= 0:
+            return
+        time.sleep(min(1.0, left))
+
+
